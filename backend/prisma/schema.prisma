// Schéma Prisma EventFoundry — référence unique du modèle de données (TSPEC.02).
// Conventions : tables au pluriel snake_case, modèles PascalCase, champs camelCase + @map,
// clés primaires UUID générées côté application, dates en UTC (timestamptz).
//
// Les modèles complets seront ajoutés à l'EPIC 4 (Persistance), conformément à ARCHI.03 :
//   User, Attachment, ImportJob, EventCandidate, Event,
//   Domain, Activity, EventType, EventFormat, Alias, Organizer, Venue, UserParticipation.
// Chaque évolution passe par une migration Prisma Migrate.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion n'est plus dans le schéma. Elle est fournie à Migrate via
// prisma.config.ts, et au client applicatif via un driver adapter (@prisma/adapter-pg).
datasource db {
  provider = "postgresql"
}

// --- Énumérations (miroir de @event-foundry/contracts) ---

enum ImportJobStatus {
  PENDING
  OCR_RUNNING
  OCR_DONE
  CLASSIFICATION_RUNNING
  READY_FOR_VALIDATION
  COMPLETED
  FAILED
}

enum EventCandidateStatus {
  PENDING
  CORRECTED
  VALIDATED
  REJECTED
}

enum EventSource {
  IMPORT
  MANUAL
}

/// Statut de publication d'un Event (workflow Publishing — EPIC 04) :
/// DRAFT → SUBMITTED → PUBLISHED, et ARCHIVED. Les transitions sont contrôlées par le domaine ;
/// chaque passage est journalisé dans event_status_events (traçabilité).
enum EventStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  ARCHIVED
}

enum AttachmentType {
  IMAGE
  TEXT
}

enum ReservationStatus {
  NONE
  RESERVED
  WAITLIST
  CANCELLED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

/// Retour utilisateur sur une recommandation (EPIC 06). ACCEPTED = intégrée à la réflexion de
/// l'utilisateur ; IGNORED / REJECTED = écartée → exclue déterministiquement des recommandations
/// futures (le moteur « apprend » uniquement des décisions explicitement observées — FSPEC.09).
enum RecommendationAction {
  ACCEPTED
  IGNORED
  REJECTED
}

/// Canal de diffusion d'une notification (EPIC 08). IN_APP est le canal interne (source de vérité
/// consultable) ; EMAIL / PUSH sont des canaux de diffusion complémentaires.
enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

/// État d'une notification interne (in-app) du point de vue du destinataire.
enum NotificationStatus {
  UNREAD
  READ
}

// --- Identity V2 (EPIC 01) : Roles / Permissions / Experiences / Subscriptions / Organizations.
// Modèle aligné sur ADR.08 (RBAC), ADR.11 (Identity/Role/Experience/Subscription) et FSPEC.10.
// Concepts volontairement indépendants : les rôles portent les permissions ; l'expérience ne
// modifie jamais les permissions ; l'abonnement module le niveau de service, pas les droits.

/// Portée d'un rôle : PLATFORM (Explorer, Operator, Finance…) ou ORGANIZATION (Organizer),
/// auquel cas les permissions sont évaluées dans le contexte de l'organisation active (ADR.08).
enum RoleScope {
  PLATFORM
  ORGANIZATION
}

/// Interface active de l'utilisateur (ADR.10/ADR.11). Une seule expérience active à la fois ;
/// les expériences disponibles sont déduites des rôles. Le changement d'expérience ne modifie
/// ni les rôles ni les permissions.
enum Experience {
  EXPLORER
  ORGANIZER
  OPERATOR
}

// --- Authentification & autorisation (EPIC 2) ---

/// Utilisateur de la plateforme. Le mot de passe n'est jamais stocké en clair.
model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  email                String                   @unique
  passwordHash         String                   @map("password_hash")
  displayName          String                   @map("display_name")
  isActive             Boolean                  @default(true) @map("is_active")
  roles                UserRole[]
  participations       UserParticipation[]
  recommendationFeedback RecommendationFeedback[]
  notifications        Notification[]
  createdEvents        Event[]
  // Identity V2 : appartenances aux organisations, expérience active et contexte org actif.
  memberships          OrganizationMembership[]
  activeExperience     Experience?              @map("active_experience")
  activeOrganizationId String?                  @map("active_organization_id") @db.Uuid
  activeOrganization   Organization?            @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  // Préférences utilisateur (JSONB) : thème, langue, etc. Aucune donnée métier.
  preferences          Json?                    @db.JsonB
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

/// Rôle : responsabilité métier portant un ensemble de permissions (ADR.08). `scope` distingue
/// les rôles plateforme (Explorer, Operator, Finance, Customer Success) des rôles d'organisation
/// (Organizer). `experience` = expérience débloquée par ce rôle (FSPEC.10), sans fusionner les
/// deux notions (ADR.11). Seed initial : ADMIN/USER (legacy V1) + rôles V2.
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  scope       RoleScope        @default(PLATFORM)
  experience  Experience?
  users       UserRole[]
  permissions RolePermission[]
  memberships MembershipRole[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
}

/// Permission : capacité métier atomique (ex. `event.publish`). Unité de contrôle du backend
/// (ADR.08). Accordée aux rôles, jamais directement aux utilisateurs.
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("permissions")
}

/// Rattachement N-N Role ↔ Permission.
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Affectation d'un rôle PLATEFORME à un utilisateur (Explorer, Operator, Finance…).
/// Les rôles d'ORGANISATION passent par MembershipRole (contexte org).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Organisation : structure au sein de laquelle un Organizer publie (association, mairie,
/// entreprise…). Les permissions d'un rôle d'organisation sont évaluées dans son contexte (ADR.08).
model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  slug               String                   @unique
  isActive           Boolean                  @default(true) @map("is_active")
  subscriptionPlanId String?                  @map("subscription_plan_id") @db.Uuid
  subscriptionPlan   SubscriptionPlan?        @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  memberships        OrganizationMembership[]
  activeForUsers     User[]                   @relation("UserActiveOrganization")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organizations")
}

/// Appartenance d'un utilisateur à une organisation, porteuse de ses rôles d'organisation.
model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Rôle d'ORGANISATION affecté au sein d'une appartenance (contexte org).
model MembershipRole {
  membershipId String                 @map("membership_id") @db.Uuid
  roleId       String                 @map("role_id") @db.Uuid
  assignedAt   DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(6)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

/// Offre commerciale (Free/Pro/Premium — ADR.11). Ne définit jamais les permissions : module le
/// niveau de service parmi les fonctionnalités autorisées. `level` ordonne les offres.
model SubscriptionPlan {
  id            String         @id @default(uuid()) @db.Uuid
  key           String         @unique
  name          String
  level         Int            @default(0)
  isActive      Boolean        @default(true) @map("is_active")
  organizations Organization[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscription_plans")
}

// --- Référentiels métier (EPIC 3) ---
// Hiérarchie : Domain -> Activity -> EventType / EventFormat(optionnel).
// Suppression logique via is_active (ARCHI.03, FSPEC.07) : les valeurs inactives ne sont
// plus proposées mais restent référencées par les Events historiques.

model Domain {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  isActive   Boolean    @default(true) @map("is_active")
  activities Activity[]
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("domains")
}

model Activity {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  domainId     String        @map("domain_id") @db.Uuid
  isActive     Boolean       @default(true) @map("is_active")
  domain       Domain        @relation(fields: [domainId], references: [id], onDelete: Restrict)
  eventTypes   EventType[]
  eventFormats EventFormat[]
  aliases      Alias[]
  events       Event[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([domainId, name])
  @@index([domainId])
  @@map("activities")
}

model EventType {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  activityId String   @map("activity_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  events     Event[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([activityId, name])
  @@index([activityId])
  @@map("event_types")
}

model EventFormat {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  activityId String   @map("activity_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  events     Event[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([activityId, name])
  @@index([activityId])
  @@map("event_formats")
}

/// Écriture alternative reconnue par le moteur expert (ex. « MTG » -> Magic).
/// La valeur est unique : une écriture ne référence qu'une seule valeur métier (FSPEC.07).
model Alias {
  id         String   @id @default(uuid()) @db.Uuid
  value      String   @unique
  activityId String   @map("activity_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([activityId])
  @@map("aliases")
}

model Organizer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  website   String?
  isActive  Boolean  @default(true) @map("is_active")
  venues    Venue[]
  events    Event[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organizers")
}

model Venue {
  id          String     @id @default(uuid()) @db.Uuid
  organizerId String?    @map("organizer_id") @db.Uuid
  name        String
  address     String?
  postalCode  String?    @map("postal_code")
  city        String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean    @default(true) @map("is_active")
  organizer   Organizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  events      Event[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizerId])
  @@map("venues")
}

// --- Référentiels géographiques (EPIC 02) : Country -> Region -> Municipality ---
// Hiérarchie simple (les hiérarchies complexes relèvent de la V3 — TSPEC.08). Archivage logique
// via is_active. RESTRICT sur les relations : un parent référencé ne peut être supprimé.

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String?  @unique // ISO 3166-1 alpha-2 (optionnel)
  isActive  Boolean  @default(true) @map("is_active")
  regions   Region[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("countries")
}

model Region {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  countryId      String         @map("country_id") @db.Uuid
  isActive       Boolean        @default(true) @map("is_active")
  country        Country        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  municipalities Municipality[]
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([countryId, name])
  @@index([countryId])
  @@map("regions")
}

model Municipality {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  regionId   String   @map("region_id") @db.Uuid
  postalCode String?  @map("postal_code")
  isActive   Boolean  @default(true) @map("is_active")
  region     Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events     Event[]

  @@unique([regionId, name])
  @@index([regionId])
  @@index([postalCode])
  @@map("municipalities")
}

// --- Référentiels transverses (EPIC 02) : Category, Tag ---

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events    Event[]

  @@map("categories")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  eventTags EventTag[]

  @@map("tags")
}

// --- Acquisition & pipeline d'import (EPIC 5) ---

/// Document original importé, conservé dans MinIO (jamais en base — ARCHI.01).
model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  type          AttachmentType
  originalName  String?        @map("original_name")
  contentType   String         @map("content_type")
  sizeBytes     Int            @map("size_bytes")
  checksum      String
  storageBucket String         @map("storage_bucket")
  storageKey    String         @map("storage_key")
  importJob     ImportJob?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([checksum])
  @@map("attachments")
}

/// Suit le cycle technique d'un import (un Attachment = un ImportJob).
model ImportJob {
  id                  String           @id @default(uuid()) @db.Uuid
  attachmentId        String           @unique @map("attachment_id") @db.Uuid
  status              ImportJobStatus  @default(PENDING)
  ocrText             String?          @map("ocr_text")
  // Métadonnées de l'OCRResult source, conservées pour la traçabilité / rejouabilité
  // du pipeline (règle d'or 9 ; TSPEC.03 « Conservation des artefacts »). Nulles tant
  // que l'OCR n'a pas abouti. Repropagées par le ClassificationResult (les Workers
  // n'accèdent jamais à PostgreSQL).
  ocrConfidence       Float?           @map("ocr_confidence")
  ocrLanguage         String?          @map("ocr_language")
  ocrEngine           String?          @map("ocr_engine")
  ocrEngineVersion    String?          @map("ocr_engine_version")
  ocrPageCount        Int?             @map("ocr_page_count")
  ocrProcessingTimeMs Int?             @map("ocr_processing_time_ms")
  correlationId       String           @map("correlation_id")
  startedAt           DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime?        @map("finished_at") @db.Timestamptz(6)
  attachment          Attachment       @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  candidates          EventCandidate[]
  events              ImportJobEvent[]
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@map("import_jobs")
}

/// Journal des transitions d'état d'un ImportJob (une ligne par passage d'état). Le Backend
/// orchestrant chaque étape du pipeline, il historise chaque transition : cela permet les
/// statistiques sur les passages entre états et les durées par étape (TSPEC.06 / ARCHI.02).
/// Sous-entité d'audit : supprimée avec son ImportJob (Cascade).
model ImportJobEvent {
  id            String          @id @default(uuid()) @db.Uuid
  importJobId   String          @map("import_job_id") @db.Uuid
  status        ImportJobStatus
  correlationId String          @map("correlation_id")
  occurredAt    DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  importJob     ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([status])
  @@index([occurredAt])
  @@map("import_job_events")
}

// --- Validation & Events (EPIC 8) ---

/// Proposition d'événement issue du moteur expert, avant validation utilisateur.
/// payload = brouillon d'Event ; confidence = un score par champ détecté (ARCHI.03).
model EventCandidate {
  id          String               @id @default(uuid()) @db.Uuid
  importJobId String               @map("import_job_id") @db.Uuid
  status      EventCandidateStatus @default(PENDING)
  payload     Json
  confidence  Json
  eventId     String?              @unique @map("event_id") @db.Uuid
  correctedBy String?              @map("corrected_by") @db.Uuid
  correctedAt DateTime?            @map("corrected_at") @db.Timestamptz(6)
  importJob   ImportJob            @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  event       Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@index([importJobId])
  @@map("event_candidates")
}

/// Événement officiel de la plateforme. source figée (IMPORT/MANUAL). Suppression logique.
/// Le Domain n'est pas stocké : il est déduit de l'Activity.
model Event {
  id             String              @id @default(uuid()) @db.Uuid
  source         EventSource
  status         EventStatus         @default(PUBLISHED)
  activityId     String              @map("activity_id") @db.Uuid
  eventTypeId    String?             @map("event_type_id") @db.Uuid
  eventFormatId  String?             @map("event_format_id") @db.Uuid
  categoryId     String?             @map("category_id") @db.Uuid
  organizerId    String?             @map("organizer_id") @db.Uuid
  venueId        String?             @map("venue_id") @db.Uuid
  municipalityId String?             @map("municipality_id") @db.Uuid
  title          String
  description    String?
  startsAt       DateTime            @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?           @map("ends_at") @db.Timestamptz(6)
  price          Float?
  currency       String?
  createdById    String?             @map("created_by_id") @db.Uuid
  publishedAt    DateTime?           @map("published_at") @db.Timestamptz(6)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  activity       Activity            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  eventType      EventType?          @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  eventFormat    EventFormat?        @relation(fields: [eventFormatId], references: [id], onDelete: SetNull)
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  organizer      Organizer?          @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  venue          Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  municipality   Municipality?       @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  tags           EventTag[]
  media          EventMedia[]
  statusEvents   EventStatusEvent[]
  candidate      EventCandidate?
  searchDocument SearchDocument?
  recommendationFeedback RecommendationFeedback[]
  notifications  Notification[]
  participations UserParticipation[]
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([startsAt])
  @@index([venueId])
  @@index([organizerId])
  @@index([activityId])
  @@index([categoryId])
  @@index([municipalityId])
  @@index([status])
  @@index([source])
  @@map("events")
}

/// Rattachement N-N Event ↔ Tag (classification transverse du catalogue — EPIC 03).
model EventTag {
  eventId String @map("event_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([eventId, tagId])
  @@index([tagId])
  @@map("event_tags")
}

/// Média (image) d'un Event. Le fichier vit dans MinIO (ARCHI.01) ; seule la clé d'objet est en
/// base. `position` ordonne la galerie. Supprimé en cascade avec l'Event.
model EventMedia {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  objectKey   String   @map("object_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  position    Int      @default(0)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventId])
  @@map("event_media")
}

/// Journal d'audit des transitions de statut d'un Event (workflow Publishing — EPIC 04).
/// Une ligne par passage d'état ; base de la traçabilité et des statistiques de publication.
model EventStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  eventId    String       @map("event_id") @db.Uuid
  fromStatus EventStatus? @map("from_status")
  toStatus   EventStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([eventId, occurredAt])
  @@map("event_status_events")
}

/// Projection technique de recherche (TSPEC.09 — domaine Search). Un document par Event publié,
/// entièrement reconstructible depuis le Catalog (jamais source de vérité). Le vecteur plein texte
/// pondéré (`search_vector`, tsvector) est maintenu par le Repository Search via SQL et indexé en
/// GIN. Le document est retiré dès qu'un Event quitte l'état publié (dépublication / archivage /
/// suppression logique).
model SearchDocument {
  eventId          String                   @id @map("event_id") @db.Uuid
  title            String
  description      String?
  activityId       String                   @map("activity_id") @db.Uuid
  activityName     String                   @map("activity_name")
  categoryId       String?                  @map("category_id") @db.Uuid
  categoryName     String?                  @map("category_name")
  municipalityId   String?                  @map("municipality_id") @db.Uuid
  municipalityName String?                  @map("municipality_name")
  organizerName    String?                  @map("organizer_name")
  venueName        String?                  @map("venue_name")
  tagIds           String[]                 @map("tag_ids") @db.Uuid
  tagNames         String[]                 @map("tag_names")
  startsAt         DateTime                 @map("starts_at") @db.Timestamptz(6)
  publishedAt      DateTime?                @map("published_at") @db.Timestamptz(6)
  searchVector     Unsupported("tsvector")? @map("search_vector")
  indexedAt        DateTime                 @default(now()) @map("indexed_at") @db.Timestamptz(6)
  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([categoryId])
  @@index([municipalityId])
  @@index([startsAt])
  @@index([searchVector], type: Gin)
  @@map("search_documents")
}

/// Retour utilisateur sur une recommandation (EPIC 06 — moteur déterministe ADR.09). Le moteur
/// calcule les recommandations à la volée ; seule la décision de l'utilisateur est persistée. Une
/// recommandation ignorée / refusée est déterministiquement exclue des propositions ultérieures.
/// Un seul retour par couple (user, event) ; la dernière décision fait foi.
model RecommendationFeedback {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  eventId   String               @map("event_id") @db.Uuid
  action    RecommendationAction
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("recommendation_feedback")
}

/// Notification interne destinée à un utilisateur (EPIC 08). Le domaine Notifications transforme
/// des événements métier d'autres domaines en messages ; il ne porte aucune décision métier. La
/// notification est un canal de communication, jamais un objet métier (TSPEC.07). Le lien vers
/// l'Event est optionnel (contexte de rebond) et facultatif.
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(UNREAD)
  eventId   String?             @map("event_id") @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Relation personnelle d'un utilisateur avec un Event (FSPEC.06). Trois axes indépendants.
/// Un seul enregistrement par couple (user, event). Supprimé dès que tout redevient neutre.
model UserParticipation {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  interested        Boolean           @default(false)
  reservationStatus ReservationStatus @default(NONE) @map("reservation_status")
  paymentStatus     PaymentStatus     @default(NONE) @map("payment_status")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("user_participation")
}
