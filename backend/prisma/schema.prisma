// Schéma Prisma EventFoundry — référence unique du modèle de données (TSPEC.02).
// Conventions : tables au pluriel snake_case, modèles PascalCase, champs camelCase + @map,
// clés primaires UUID générées côté application, dates en UTC (timestamptz).
//
// Les modèles complets seront ajoutés à l'EPIC 4 (Persistance), conformément à ARCHI.03 :
//   User, Attachment, ImportJob, EventCandidate, Event,
//   Domain, Activity, EventType, EventFormat, Alias, Organizer, Venue, UserParticipation.
// Chaque évolution passe par une migration Prisma Migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Énumérations (miroir de @event-foundry/contracts) ---

enum ImportJobStatus {
  PENDING
  OCR_RUNNING
  OCR_DONE
  CLASSIFICATION_RUNNING
  READY_FOR_VALIDATION
  COMPLETED
  FAILED
}

enum EventCandidateStatus {
  PENDING
  CORRECTED
  VALIDATED
  REJECTED
}

enum EventSource {
  IMPORT
  MANUAL
}

enum AttachmentType {
  IMAGE
  TEXT
}

enum ReservationStatus {
  NONE
  RESERVED
  WAITLIST
  CANCELLED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

// --- Authentification & autorisation (EPIC 2) ---

/// Utilisateur de la plateforme. Le mot de passe n'est jamais stocké en clair.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  isActive     Boolean    @default(true) @map("is_active")
  roles        UserRole[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

/// Rôle système (donnée initialisée par le seed : ADMIN, USER).
model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  users     UserRole[]
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
}

/// Affectation explicite d'un rôle à un utilisateur (relation N-N).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

// --- Référentiels métier (EPIC 3) ---
// Hiérarchie : Domain -> Activity -> EventType / EventFormat(optionnel).
// Suppression logique via is_active (ARCHI.03, FSPEC.07) : les valeurs inactives ne sont
// plus proposées mais restent référencées par les Events historiques.

model Domain {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  isActive   Boolean    @default(true) @map("is_active")
  activities Activity[]
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("domains")
}

model Activity {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  domainId     String        @map("domain_id") @db.Uuid
  isActive     Boolean       @default(true) @map("is_active")
  domain       Domain        @relation(fields: [domainId], references: [id], onDelete: Restrict)
  eventTypes   EventType[]
  eventFormats EventFormat[]
  aliases      Alias[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([domainId, name])
  @@index([domainId])
  @@map("activities")
}

model EventType {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  activityId String   @map("activity_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([activityId, name])
  @@index([activityId])
  @@map("event_types")
}

model EventFormat {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  activityId String   @map("activity_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([activityId, name])
  @@index([activityId])
  @@map("event_formats")
}

/// Écriture alternative reconnue par le moteur expert (ex. « MTG » -> Magic).
/// La valeur est unique : une écriture ne référence qu'une seule valeur métier (FSPEC.07).
model Alias {
  id         String   @id @default(uuid()) @db.Uuid
  value      String   @unique
  activityId String   @map("activity_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([activityId])
  @@map("aliases")
}

model Organizer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  website   String?
  isActive  Boolean  @default(true) @map("is_active")
  venues    Venue[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("organizers")
}

model Venue {
  id          String     @id @default(uuid()) @db.Uuid
  organizerId String?    @map("organizer_id") @db.Uuid
  name        String
  address     String?
  postalCode  String?    @map("postal_code")
  city        String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean    @default(true) @map("is_active")
  organizer   Organizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizerId])
  @@map("venues")
}
