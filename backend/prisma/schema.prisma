// Schéma Prisma EventFoundry — référence unique du modèle de données (TSPEC.02).
// Conventions : tables au pluriel snake_case, modèles PascalCase, champs camelCase + @map,
// clés primaires UUID générées côté application, dates en UTC (timestamptz).
//
// Les modèles complets seront ajoutés à l'EPIC 4 (Persistance), conformément à ARCHI.03 :
//   User, Attachment, ImportJob, EventCandidate, Event,
//   Domain, Activity, EventType, EventFormat, Alias, Organizer, Venue, UserParticipation.
// Chaque évolution passe par une migration Prisma Migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Énumérations (miroir de @event-foundry/contracts) ---

enum ImportJobStatus {
  PENDING
  OCR_RUNNING
  OCR_DONE
  CLASSIFICATION_RUNNING
  READY_FOR_VALIDATION
  COMPLETED
  FAILED
}

enum EventCandidateStatus {
  PENDING
  CORRECTED
  VALIDATED
  REJECTED
}

enum EventSource {
  IMPORT
  MANUAL
}

enum AttachmentType {
  IMAGE
  TEXT
}

enum ReservationStatus {
  NONE
  RESERVED
  WAITLIST
  CANCELLED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

// --- Authentification & autorisation (EPIC 2) ---

/// Utilisateur de la plateforme. Le mot de passe n'est jamais stocké en clair.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  isActive     Boolean    @default(true) @map("is_active")
  roles        UserRole[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

/// Rôle système (donnée initialisée par le seed : ADMIN, USER).
model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  users     UserRole[]
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
}

/// Affectation explicite d'un rôle à un utilisateur (relation N-N).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}
