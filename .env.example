# Copier vers .env pour le développement local. Ne jamais versionner .env.
# En production, les secrets sont injectés par Kubernetes (TSPEC.07).
#
# COHABITATION MULTI-PROJETS : si un autre stack occupe déjà 5432/6379/9000, changez
# les ports hôtes ci-dessous (ex. 5442/6389/9100) ET répercutez-les dans DATABASE_URL,
# REDIS_PORT, REDIS_URL, MINIO_PORT. Les ports INTERNES des conteneurs restent standards.

# --- PostgreSQL ---
POSTGRES_USER=eventfoundry
POSTGRES_PASSWORD=eventfoundry
POSTGRES_DB=eventfoundry
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eventfoundry:eventfoundry@localhost:5432/eventfoundry?schema=public

# --- Redis / BullMQ ---
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379

# --- MinIO ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_ROOT_USER=eventfoundry
MINIO_ROOT_PASSWORD=eventfoundry
MINIO_BUCKET=event-foundry-attachments
MINIO_USE_SSL=false

# --- Backend ---
API_PORT=3000
API_PREFIX=/api/v1
# Origines autorisées (séparées par des virgules). localhost et 127.0.0.1 sont distincts.
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Administrateur de développement créé par le seed (jamais utilisé en production).
DEV_ADMIN_EMAIL=admin@event-foundry.local
DEV_ADMIN_PASSWORD=change-me-dev-only

# --- Import / acquisition ---
# Taille maximale d'un document importé (octets). 20 Mo par défaut.
MAX_UPLOAD_BYTES=20971520

# --- OCR Worker ---
OCR_LANGUAGES=fra+eng
# Nombre de Jobs OCR traités en parallèle par instance de worker.
OCR_CONCURRENCY=2
# Port HTTP des sondes de santé du worker (liveness /health, readiness /health/ready).
OCR_HEALTH_PORT=3001
# Réglages OCR (prétraitement sharp + Tesseract). Voir ocr-worker/eval pour les mesurer.
OCR_PSM=11
OCR_OEM=1
# Modèles : « standard » (défaut), « best » (plus précis, plus lent) ou « fast » (plus léger).
# NB : le worker utilise tesseract.js 6 à dessein. La v7 embarque un core WASM
# « relaxedsimd-lstm » cassé (fonction `DotProductSSE` = stub qui abort) ; sur un CPU relaxed-SIMD
# (ex. WSL2/Node 22) elle crashe `Aborted(missing function DotProductSSE)` quelle que soit la
# variante. La v6 charge le core `simd-lstm` sain : toutes les variantes fonctionnent.
OCR_TESSDATA=standard
OCR_MIN_WIDTH=1500
OCR_BINARIZE_THRESHOLD=140
# Modèles distants par défaut (CDN, gzip). Pour des modèles locaux : pointer OCR_LANG_PATH
# vers un dossier tessdata et poser OCR_LANG_GZIP=false.
# OCR_LANG_PATH=/usr/share/tesseract-ocr/5/tessdata
# OCR_LANG_GZIP=false
# Correction lexicale post-OCR alimentée par les référentiels (levier 3). Le lexique est
# chargé via l'API Backend (le worker n'accède jamais à PostgreSQL). À défaut, réutilise les
# identifiants du classifier.
OCR_LEXICON_CORRECTION=true
# OCR_BACKEND_URL=http://localhost:3000/api/v1
# OCR_SERVICE_EMAIL=admin@event-foundry.local
# OCR_SERVICE_PASSWORD=change-me-dev-only

# --- Classifier Worker ---
CLASSIFIER_CONCURRENCY=2
# Port HTTP des sondes de santé du worker (liveness /health, readiness /health/ready).
CLASSIFIER_HEALTH_PORT=3002
# Référentiels chargés via l'API Backend (le worker n'accède jamais à PostgreSQL).
CLASSIFIER_BACKEND_URL=http://localhost:3000/api/v1
CLASSIFIER_SERVICE_EMAIL=admin@event-foundry.local
CLASSIFIER_SERVICE_PASSWORD=change-me-dev-only
# Durée du cache des référentiels (ms).
REFERENCE_TTL_MS=300000
