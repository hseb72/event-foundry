# Copier vers .env pour le développement local. Ne jamais versionner .env.
# En production, les secrets sont injectés par Kubernetes (TSPEC.07).

# --- PostgreSQL ---
POSTGRES_USER=eventfoundry
POSTGRES_PASSWORD=eventfoundry
POSTGRES_DB=eventfoundry
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eventfoundry:eventfoundry@localhost:5432/eventfoundry?schema=public

# --- Redis / BullMQ ---
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379

# --- MinIO ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_ROOT_USER=eventfoundry
MINIO_ROOT_PASSWORD=eventfoundry
MINIO_BUCKET=event-foundry-attachments
MINIO_USE_SSL=false

# --- Backend ---
API_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4200

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Administrateur de développement créé par le seed (jamais utilisé en production).
DEV_ADMIN_EMAIL=admin@event-foundry.local
DEV_ADMIN_PASSWORD=change-me-dev-only

# --- Import / acquisition ---
# Taille maximale d'un document importé (octets). 20 Mo par défaut.
MAX_UPLOAD_BYTES=20971520

# --- OCR Worker ---
OCR_LANGUAGES=fra+eng
# Nombre de Jobs OCR traités en parallèle par instance de worker.
OCR_CONCURRENCY=2
